{
  "name": "ai-tools",
  "version": "1.0.0",
  "description": "AI-Tools - A beautiful desktop app for managing MCP servers and AI agent skills",
  "author": {
    "name": "AI-Tools Team",
    "email": "mail@folay.top"
  },
  "homepage": "https://www.ywhome.top",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:main\" \"pnpm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-platform-data.mjs",
    "build:renderer": "vite build",
    "typecheck": "npx tsc -p tsconfig.main.json --noEmit && npx tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "electron:dev": "pnpm run build:main && concurrently -k \"pnpm run dev:main\" \"pnpm run dev:renderer\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "package": "pnpm run build && electron-builder",
    "package:mac": "pnpm run build && electron-builder --mac",
    "package:win": "pnpm run build && electron-builder --win --x64",
    "package:linux": "pnpm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@tanstack/react-query": "^5.17.0",
    "electron-store": "^8.1.0",
    "fuse.js": "^7.0.0",
    "i18next": "^23.7.0",
    "jsonc-parser": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.21.0",
    "react-syntax-highlighter": "^16.1.0",
    "smol-toml": "^1.6.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "43.0.0",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "terser": "^5.46.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0",
    "vite-plugin-electron-obfuscator": "^1.0.0",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ai-tools.app",
    "npmRebuild": false,
    "productName": "AI-Tools",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      "LICENSE"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "electron@43.0.0": true,
    "esbuild@0.21.5": true
  }
}
